# 服务端口
PORT=8100

# Google Safe Browsing API Key(从 domain-api / url_detection_database 的 .env 里复制同一把)
# 不配置则安全检测返回 status=disabled, 只做可访问性检测
SAFE_BROWSING_API_KEY=

# 可访问性检测配置
# 单次请求超时(毫秒)
CHECK_TIMEOUT_MS=10000
# 失败后重试次数(总尝试次数 = 1 + RETRIES)
RETRIES=1
# 重试间隔(毫秒)
RETRY_DELAY_MS=3000

# 接口鉴权(可选): 逗号分隔的合法 key。配置后请求需带 header  x-api-key: <key>
# 留空 = 不鉴权(仅限内网/有防火墙限制时)
API_KEYS=
